{
  "name": "feed-me-maybe",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:python": "mypy",
    "lint": "prettier --check . && eslint .",
    "lint:python": "ruff check scripts",
    "format": "prettier --write .",
    "test": "npm run test:unit && npm run test:python",
    "test:python": "python3 -m unittest discover -s scripts -p 'test_*.py'",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node -e \"import('node:fs').then(fs => fs.mkdirSync('./data', { recursive: true }))\" && drizzle-kit migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@skeletonlabs/skeleton": "^5.0.6",
    "@skeletonlabs/skeleton-svelte": "^5.0.6",
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/parser": "^8.73.0",
    "@vite-pwa/sveltekit": "^2.0.4",
    "@vite-pwa/workbox-swkit": "^8.0.15",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "linkedom": "^0.18.15",
    "marked": "^18.2.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.18.2",
    "undici": "^8.13.1",
    "zod": "^4.6.7"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
