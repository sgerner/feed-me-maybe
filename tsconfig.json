{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "sourceMap": true,
    "target": "es2022"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "scripts/**/*.js",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "reddit-proxy/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["node_modules", ".svelte-kit", "dist", "build"]
}
